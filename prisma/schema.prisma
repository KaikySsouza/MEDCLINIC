// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(30)
  email     String    @unique @db.VarChar(255)
  cpf       String    @unique @db.VarChar(11)
  password  String    @db.VarChar(255)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  patient   Patients?
  doctor    Doctors?
  staff     Staff?
}

model Patients {
  id           Int            @id @default(autoincrement())
  dob          DateTime
  gender       Gender?
  cep          String         @db.VarChar(8)
  address      String
  telephone    String         @db.VarChar(20)
  user_Id      Int            @unique
  user         Users          @relation(fields: [user_Id], references: [id])
  appointments Appointments[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Doctors {
  id          Int            @id @default(autoincrement())
  crmNumber   String         @db.VarChar(10) // só os dígitos
  crmState    String         @db.VarChar(2) // UF: SP, RJ, MG...
  telephone   String         @db.VarChar(20)
  user_Id     Int            @unique
  user        Users          @relation(fields: [user_Id], references: [id])
  appointment Appointments[]
  specialties Specialty[] // N-N implícito
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([crmNumber, crmState])
}

model Specialty {
  id      Int       @id @default(autoincrement())
  name    String    @unique @db.VarChar(100)
  doctors Doctors[] // lado inverso
}

model Appointments {
  id                   Int        @id @default(autoincrement())
  appointment_datetime DateTime
  duration             Int
  status               Status     @default(SCHEDULED)
  doctor_Id            Int
  patient_Id           Int
  doctor               Doctors    @relation(fields: [doctor_Id], references: [id])
  patient              Patients   @relation(fields: [patient_Id], references: [id])
  billing              Billings[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
}

model Billings {
  id             Int           @id @default(autoincrement())
  amount         Decimal       @db.Decimal(10, 2)
  billing_date   DateTime
  payment_status PaymentStatus @default(PENDING)
  appointment_Id Int
  appointment    Appointments  @relation(fields: [appointment_Id], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Staff {
  id        Int           @id @default(autoincrement())
  role      Role          @default(ADMIN)
  user_Id   Int           @unique
  user      Users         @relation(fields: [user_Id], references: [id])
  inventory Inventories[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Inventories {
  id           Int      @id @default(autoincrement())
  itemName     String
  quantity     Int
  warehouse_Id Int
  warehouse    Staff    @relation(fields: [warehouse_Id], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  OTHER
  PREFER_NOT_TO_SAY
}

enum Status {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum Role {
  ADMIN
  RECEPTIONIST
  WAREHOUSE
}
